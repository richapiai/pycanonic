{
  "spec": {
    "language": 2,
    "provider": "acme",
    "endpoint": "people",
    "version": 1,
    "status": "promoted",
    "fields": {
      "doc": {
        "aggregate": "first",
        "from": "media[].url",
        "filter": {
          "path": "type",
          "eq": "document"
        }
      },
      "n": {
        "aggregate": "count",
        "from": "media",
        "filter": {
          "path": "type",
          "in": [
            "document",
            "image"
          ]
        }
      },
      "total": {
        "aggregate": "sum",
        "from": "media[].size",
        "filter": {
          "path": "type",
          "eq": "document"
        }
      },
      "has_doc": {
        "aggregate": "any",
        "from": "media[].ok",
        "filter": {
          "path": "type",
          "eq": "document"
        }
      },
      "all_ok": {
        "aggregate": "all",
        "from": "media[].ok",
        "filter": {
          "path": "type",
          "eq": "document"
        }
      }
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "doc": {
        "type": "string"
      },
      "n": {
        "type": "number"
      },
      "total": {
        "type": "number"
      },
      "has_doc": {
        "type": "boolean"
      },
      "all_ok": {
        "type": "boolean"
      }
    }
  },
  "inputs": [
    {
      "body": {
        "media": [
          {
            "type": "image",
            "url": "https://x.example/a.png",
            "size": 5,
            "ok": false
          },
          {
            "type": "document",
            "url": "https://x.example/d.pdf",
            "size": 10,
            "ok": true
          },
          {
            "type": "document",
            "url": "https://x.example/e.pdf",
            "size": 20,
            "ok": false
          }
        ]
      },
      "context": null,
      "expected": {
        "doc": "https://x.example/d.pdf",
        "n": 3,
        "total": 30,
        "has_doc": true,
        "all_ok": false
      }
    },
    {
      "body": {
        "media": [
          {
            "type": "document",
            "url": "https://x.example/d.pdf",
            "size": 7,
            "ok": true
          },
          {
            "type": "image",
            "url": "https://x.example/a.png",
            "size": 9,
            "ok": false
          }
        ]
      },
      "context": null,
      "expected": {
        "doc": "https://x.example/d.pdf",
        "n": 2,
        "total": 7,
        "has_doc": true,
        "all_ok": true
      }
    },
    {
      "body": {
        "media": [
          {
            "type": "image",
            "url": "https://x.example/a.png"
          },
          {
            "type": "video"
          }
        ]
      },
      "context": null,
      "expected": {
        "doc": null,
        "n": 1,
        "total": 0,
        "has_doc": false,
        "all_ok": true
      }
    },
    {
      "body": {
        "media": []
      },
      "context": null,
      "expected": {
        "doc": null,
        "n": 0,
        "total": 0,
        "has_doc": false,
        "all_ok": true
      }
    },
    {
      "body": {},
      "context": null,
      "expected": {
        "doc": null,
        "n": 0,
        "total": 0,
        "has_doc": false,
        "all_ok": true
      }
    },
    {
      "body": {
        "media": "none"
      },
      "context": null,
      "expected": {
        "doc": null,
        "n": null,
        "total": null,
        "has_doc": null,
        "all_ok": null
      }
    }
  ]
}
