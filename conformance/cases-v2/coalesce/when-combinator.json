          "id"
        ],
        "transform": "upper"
      }
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "string"
      }
    }
  },
  "inputs": [
    {
      "body": {
        "share": "good",
        "id": "x"
      },
      "context": null,
      "expected": {
        "ref": "GOOD"
      }
    },
    {
      "body": {
        "share": "a bad one",
        "alt": "y",
        "id": "x"
      },
      "context": null,
      "expected": {
        "ref": "Y"
      }
    },
    {
      "body": {
        "share": "a bad one",
        "id": "x"
      },
