{
  "spec": {
    "language": 2,
    "provider": "acme",
    "endpoint": "people",
    "version": 1,
    "status": "promoted",
    "fields": {
      "slug": {"from": "url", "transform": {"regex": "/company/([^/?#]+)"}},
      "member_id": {"from": "urn", "transform": {"strip_prefix": "urn:acme:member:"}},
      "repo": {"from": "repo", "transform": {"strip_suffix": ".git"}},
      "phone": {"from": "phone", "transform": {"replace": {"pattern": "[^0-9]+", "to": ""}}},
      "tag": {"from": "tag", "transform": {"replace": {"from": "_", "to": " "}}},
      "reaction": {"from": "reaction", "transform": {"lookup": {"table": {"LIKE": "liked", "1": "one"}, "else": "keep"}}},
      "size": {"from": "size", "transform": {"null_if": ["", "N/A", 0]}},
      "code": {"from": "code", "transform": "upper"},
      "name": {"from": "name", "transform": "title"},
      "last_name": {"from": "name", "transform": [{"split": {"sep": " ", "index": -1}}, "title"]},
      "zip": {"from": "zip", "transform": "to_string"}
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "slug": {"type": "string"},
      "member_id": {"type": "string"},
      "repo": {"type": "string"},
      "phone": {"type": "string"},
      "tag": {"type": "string"},
      "reaction": {"type": "string"},
      "size": {"type": ["string", "number"]},
      "code": {"type": "string"},
      "name": {"type": "string"},
      "last_name": {"type": "string"},
      "zip": {"type": "string"}
    }
  },
