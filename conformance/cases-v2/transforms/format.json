{
  "spec": {
    "language": 2,
    "provider": "acme",
    "endpoint": "items",
    "version": 1,
    "status": "promoted",
    "fields": {
      "one": {
        "from": "id",
        "transform": {
          "format": "urn:example:item:{}"
        }
      },
      "zero": {
        "from": "id",
        "transform": {
          "format": "item/{0}"
        }
      },
      "pair": {
        "from": [
          "org",
          "name"
        ],
        "transform": {
          "format": "{0}/{1}"
        }
      },
      "swap": {
        "from": [
          "org",
          "name"
        ],
        "transform": {
          "format": "{1} at {1} and {0}"
        }
      },
      "esc": {
        "from": "id",
        "transform": {
          "format": "{{x}}={}"
        }
      },
      "chain": {
        "from": "id",
        "transform": [
          {
            "strip_prefix": "id:"
          },
          {
            "format": "https://x.example/people/{}"
          }
        ]
      }
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "one": {
        "type": "string"
