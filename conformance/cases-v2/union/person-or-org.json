{
  "spec": {
    "language": 2,
    "provider": "acme",
    "endpoint": "posts",
    "version": 1,
    "status": "promoted",
    "fields": {
      "title": "title",
      "author": {
        "one_of": [
          {
            "branch": "person",
            "when": {
              "path": "author.url",
              "contains": "/people/"
            },
            "fields": {
              "kind": "author.kind",
              "last": "author.family",
              "first": "author.given",
              "id": "author.id"
            }
          },
          {
            "branch": "org",
            "fields": {
              "id": "author.id",
              "name": "author.display",
              "followers": "author.followers",
              "kind": "author.kind"
            }
          }
        ]
      }
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "author": {
        "type": "object",
        "oneOf": [
          {
            "title": "person",
            "properties": {
              "id": {
                "type": "string"
              },
              "first": {
                "type": "string"
              },
              "last": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          },
          {
            "title": "org",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "followers": {
                "type": "integer"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "inputs": [
    {
      "body": {
        "title": "Hi",
        "author": {
          "url": "https://x.example/people/ada",
          "id": "urn:example:person:1",
          "given": "Ada",
          "family": "Lovelace",
          "kind": "PERSON"
        }
      },
      "context": null,
      "expected": {
        "title": "Hi",
        "author": {
          "id": "urn:example:person:1",
          "first": "Ada",
          "last": "Lovelace",
          "kind": "PERSON"
        }
      }
    },
    {
      "body": {
        "author": {
          "url": "https://x.example/orgs/acme",
          "id": "urn:example:org:7",
          "display": "Acme",
          "followers": 120,
          "kind": "ORG"
        }
      },
      "context": null,
      "expected": {
        "title": null,
        "author": {
          "id": "urn:example:org:7",
          "name": "Acme",
          "followers": 120,
          "kind": "ORG"
        }
      }
    },
    {
      "body": {
        "author": {
          "url": "https://x.example/teams/blue",
          "id": "urn:example:team:3",
          "display": "Blue",
          "kind": "TEAM"
        }
      },
      "context": null,
      "expected": {
        "title": null,
        "author": {
          "id": "urn:example:team:3",
          "name": "Blue",
          "followers": null,
          "kind": "TEAM"
        }
      }
    },
    {
      "body": {
        "title": "Hi"
      },
      "context": null,
      "expected": {
        "title": "Hi",
        "author": null
      }
    },
    {
      "body": {
        "author": null
      },
      "context": null,
      "expected": {
        "title": null,
        "author": null
      }
    },
    {
      "body": {
        "author": "text"
      },
      "context": null,
      "expected": {
        "title": null,
        "author": null
      }
    },
    {
      "body": {
        "author": {
          "url": "https://x.example/people/bo"
        }
      },
      "context": null,
      "expected": {
        "title": null,
        "author": null
      }
    }
  ]
}
