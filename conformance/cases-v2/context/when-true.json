{
  "spec": {
    "language": 2,
    "provider": "acme",
    "endpoint": "people",
    "version": 1,
    "status": "promoted",
    "fields": {
      "name": {
        "from": "name",
        "when": {
          "path": "kind",
          "eq": "person"
        }
      },
      "tag": {
        "const": "T",
        "when": [
          {
            "path": "$input.full",
            "eq": true
          },
          {
            "path": "kind",
            "in": [
              "person",
              "org"
            ]
          }
        ]
      },
      "ids[]": {
        "from": "ids",
        "when": {
          "path": "$input.full",
          "present": true
        }
      },
      "n": {
        "aggregate": "count",
        "from": "ids",
        "when": {
          "path": "$input.full",
          "eq": true
        }
      }
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "ids": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "n": {
        "type": "number"
      }
    }
  },
  "inputs": [
    {
      "body": {
        "kind": "person",
        "name": "a",
        "ids": [
          1,
          2
        ]
      },
      "context": {
        "full": true
      },
      "expected": {
        "name": "a",
        "tag": "T",
        "ids": [
          1,
          2
        ],
        "n": 2
      }
    }
  ]
}
