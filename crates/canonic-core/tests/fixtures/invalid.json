    },
    {
      "name": "array rule coalesce",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills[]": {
            "coalesce": [
              "a",
              "b"
            ],
            "pluck": "l"
