{
  "grammar": [
    {
      "name": "not an object",
      "spec": [
        1,
        2
      ]
    },
    {
      "name": "missing provider",
      "spec": {
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "empty endpoint",
      "spec": {
        "provider": "acme",
        "endpoint": "",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "version zero",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 0,
        "status": "promoted",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "version fraction",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1.5,
        "status": "promoted",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "version string",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": "1",
        "status": "promoted",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "unknown status",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "live",
        "fields": {
          "email": "e"
        }
      }
    },
    {
      "name": "unknown top-level key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        },
        "owner": "me"
      }
    },
    {
      "name": "schema not a string",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        },
        "$schema": 3
      }
    },
    {
      "name": "anchor empty",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        },
        "anchors": {
          "email": ""
        }
      }
    },
    {
      "name": "anchors not an object",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        },
        "anchors": [
          "email"
        ]
      }
    },
    {
      "name": "fields empty",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {}
      }
    },
    {
      "name": "fields missing",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted"
      }
    },
    {
      "name": "canonical key with dash",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "work-email": "e"
        }
      }
    },
    {
      "name": "canonical key double dot",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "a..b": "e"
        }
      }
    },
    {
      "name": "canonical key array mid-path",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "a[].b": "e"
        }
      }
    },
    {
      "name": "rule is a number",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": 5
        }
      }
    },
    {
      "name": "rule is null",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": null
        }
      }
    },
    {
      "name": "from and coalesce",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "coalesce": [
              "b",
              "c"
            ]
          }
        }
      }
    },
    {
      "name": "neither from nor coalesce",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "transform": "trim"
          }
        }
      }
    },
    {
      "name": "coalesce single path",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "coalesce": [
              "a"
            ]
          }
        }
      }
    },
    {
      "name": "tuple from single path",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": [
              "a"
            ]
          }
        }
      }
    },
    {
      "name": "empty path",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": ""
        }
      }
    },
    {
      "name": "path double dot",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a..b"
        }
      }
    },
    {
      "name": "path leading zero index",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a[01]"
        }
      }
    },
    {
      "name": "path unquoted bracket",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a[b]"
        }
      }
    },
    {
      "name": "path dot before bracket",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a.[\"b\"]"
        }
      }
    },
    {
      "name": "path with space",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a b"
        }
      }
    },
    {
      "name": "path single-quoted key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "['a']"
        }
      }
    },
    {
      "name": "path raw newline in quoted key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "[\"a\nb\"]"
        }
      }
    },
    {
      "name": "path trailing dot",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": "a."
        }
      }
    },
    {
      "name": "default object",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "default": {}
          }
        }
      }
    },
    {
      "name": "default null",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "default": null
          }
        }
      }
    },
    {
      "name": "unknown rule key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "to": "b"
          }
        }
      }
    },
    {
      "name": "transform empty name",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": ""
          }
        }
      }
    },
    {
      "name": "transform dashed name",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": "to-domain"
