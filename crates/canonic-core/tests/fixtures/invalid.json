        }
      }
    },
    {
      "name": "transform two keys",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": {
              "cast": "number",
              "trim": null
