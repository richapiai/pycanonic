  ],
  "semantic": [
    {
      "name": "unknown canonical field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "nickname": "n"
        }
      },
      "error": "fields[\"nickname\"]"
    },
    {
      "name": "scalar rule on array field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills": "t"
        }
      },
      "error": "fields[\"skills\"]"
    },
    {
      "name": "scalar rule on object field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "company": "org"
        }
      },
      "error": "fields[\"company\"]"
    },
    {
      "name": "array rule on scalar field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email[]": {
            "from": "e",
            "pluck": "x"
          }
        }
      },
      "error": "fields[\"email[]\"]"
    },
    {
      "name": "item on array of scalars",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills[]": {
            "from": "t",
            "item": {
              "x": "y"
            }
          }
        }
      },
      "error": "fields[\"skills[]\"]"
    },
    {
      "name": "pluck on array of objects",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
            "pluck": "x"
          }
        }
      },
      "error": "fields[\"experiences[]\"]"
    },
    {
      "name": "unknown transform",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": "shout"
          }
        }
      },
      "error": "fields[\"first_name\"]"
    },
    {
      "name": "cast without argument",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "headcount": {
            "from": "a",
            "transform": "cast"
          }
        }
      },
      "error": "fields[\"headcount\"]"
    },
    {
      "name": "cast bad argument",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "headcount": {
            "from": "a",
            "transform": {
              "cast": "float"
            }
          }
        }
      },
      "error": "fields[\"headcount\"]"
    },
    {
      "name": "split_name bad argument",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": {
              "split_name": "middle"
            }
          }
        }
      },
      "error": "fields[\"first_name\"]"
    },
    {
      "name": "join non-string separator",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "full_name": {
            "from": [
              "a",
              "b"
            ],
            "transform": {
              "join": 1
            }
          }
        }
      },
      "error": "fields[\"full_name\"]"
    },
    {
      "name": "argument to a no-argument transform",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": {
              "lower": true
            }
          }
        }
      },
      "error": "fields[\"first_name\"]"
    },
    {
      "name": "prototype name as transform",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": "constructor"
          }
        }
      },
      "error": "fields[\"first_name\"]"
    },
    {
      "name": "unknown field inside item",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
            "item": {
              "nope": "x"
            }
          }
        }
      },
      "error": "fields[\"experiences[]\"].item[\"nope\"]"
    },
    {
      "name": "anchor for unmapped field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": "e"
        },
        "anchors": {
          "phone": "\"mobile\":"
        }
      },
      "error": "anchors[\"phone\"]"
    },
    {
      "name": "anchor on a non-routing field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "anchors": {
          "first_name": "\"n\":"
        },
        "fields": {
          "first_name": "n"
        }
      },
      "error": "anchors[\"first_name\"]: only routing fields"
    },
    {
      "name": "anchor on a coalesce field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "anchors": {
          "email": "\"a\":"
        },
        "fields": {
          "email": {
            "coalesce": [
              "a",
              "b"
            ]
          }
        }
      },
      "error": "anchors[\"email\"]: anchored fields need a single from path"
    },
    {
      "name": "anchor on a path ending in an index",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "anchors": {
          "email": "\"a\":"
        },
        "fields": {
          "email": "a[0]"
        }
      },
      "error": "anchors[\"email\"]: anchored fields need a single from path"
    },
    {
      "name": "anchor token that doesn't match the key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "anchors": {
          "email": "\"mail\":"
        },
        "fields": {
          "email": "work.email"
        }
      },
      "error": "anchors[\"email\"]: token must be"
    },
    {
      "name": "array of objects without item",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "t"
          }
        }
      },
      "error": "fields[\"experiences[]\"]"
    },
    {
      "name": "default on a routing field",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "email": {
            "from": "e",
            "default": "none@acme.com"
          }
        }
      },
      "error": "fields[\"email\"]: routing fields can't have a default"
    }
  ]
}
