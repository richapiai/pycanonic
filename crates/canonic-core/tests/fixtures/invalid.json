    {
      "name": "array rule item and pluck",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills[]": {
            "from": "t",
            "pluck": "l",
            "item": {
              "x": "y"
            }
          }
        }
      }
    },
    {
      "name": "array rule item with transform",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
