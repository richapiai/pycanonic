          }
        }
      }
    },
    {
      "name": "transform empty object",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": {}
          }
        }
      }
    },
    {
      "name": "transform number",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "first_name": {
            "from": "a",
            "transform": 5
          }
        }
      }
    },
    {
      "name": "transform nested array",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
