        }
      }
    },
    {
      "name": "array rule tuple from",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills[]": {
            "from": [
              "a",
              "b"
            ],
            "pluck": "l"
          }
        }
      }
    },
    {
      "name": "array rule default",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "skills[]": {
            "from": "t",
            "pluck": "l",
