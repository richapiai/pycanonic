    {
      "name": "item empty",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
            "item": {}
          }
        }
      }
    },
    {
      "name": "item bad key",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
            "item": {
              "job title": "r"
            }
          }
        }
      }
    },
    {
      "name": "item bad path",
      "spec": {
        "provider": "acme",
        "endpoint": "person.enrich",
        "version": 1,
        "status": "promoted",
        "fields": {
          "experiences[]": {
            "from": "j",
            "item": {
