{
  "spec": {
    "provider": "acme",
    "endpoint": "person.enrich",
    "version": 1,
    "status": "promoted",
    "fields": {
      "first_name": {
        "from": "n",
        "transform": "trim"
      }
    }
  },
  "cases": [
    {
      "payload": {
        "n": "  Ada \n"
      },
      "expected": {
        "first_name": "Ada"
      }
    },
    {
      "payload": {
        "n": 42
      },
      "expected": {}
    }
  ]
}
